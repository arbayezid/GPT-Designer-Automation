{
  "manifest_version": 3,
  "name": "GPT Designer",
  "version": "0.1.20",
  "version_name": "0.1.20 - Last updated 2026-06-09",
  "description": "Automates Drive-backed prompt batches in ChatGPT and saves generated images back to Drive.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "tabs", "alarms", "clipboardRead"],
  "host_permissions": [
    "https://oauth2.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "assets/background.js"
  },
  "action": {
    "default_title": "GPT Designer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"],
      "js": ["assets/content.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ]
}
